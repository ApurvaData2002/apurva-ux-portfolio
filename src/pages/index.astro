---
// Home: an intro block (skill pills, then the page heading), followed by the
// project grid generated from the case-study collection.
// Drafts are left out; order comes from each case study's `order` field.
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectTile from '../components/ProjectTile.astro';
import SkillPill from '../components/SkillPill.astro';
import { getPublishedCaseStudies } from '../lib/case-studies';

const skills = ['UX Research', 'UI Design', 'User Flows', 'Prototyping'];

const caseStudies = await getPublishedCaseStudies();
// A short grid fits on one screen, so BackToTop only appears with more than 3 projects.
const showBackToTop = caseStudies.length > 3;
---

<BaseLayout active="projects" spacing="index" backToTop={showBackToTop}>
  <div class="home">
    <div class="home-intro">
      <ul class="home-intro__skills" role="list">
        {skills.map((skill) => <SkillPill>{skill}</SkillPill>)}
      </ul>
      <div class="home-intro__text">
        <h1 class="t-h1">I design mobile apps that are easy to use.</h1>
        <p class="t-lead">I’m Apurva, a UI/UX designer. Here are some of the apps I’ve worked on.</p>
      </div>
    </div>

    {
      caseStudies.length > 0 ? (
        <ul class="projects-grid" role="list">
          {caseStudies.map((entry, i) => (
            <li>
              <ProjectTile entry={entry} eager={i < 2} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="t-body">New case studies are on their way.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  /* The page container (.page--index) already applies the side padding, so the
     intro and the grid line up without any padding of their own. */
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--page-stack-gap);
  }

  .home-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .home-intro__skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .home-intro__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--index-grid-gap);
  }

  @media (min-width: 48em) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @keyframes home-rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* Staging: the pills, then the heading, then the tiles, 40ms apart, so the
     page assembles in the order it is meant to be read instead of landing all
     at once. The last tile has finished by 500ms, well inside the few seconds a
     visitor spends deciding whether to stay.
     `html[data-motion]` is set in BaseLayout before the first paint, so with no
     JavaScript or with reduced motion none of this applies and every block
     renders where it belongs. */
  :global(html[data-motion]) .home-intro__skills,
  :global(html[data-motion]) .home-intro__text,
  :global(html[data-motion]) .projects-grid > li {
    animation: home-rise var(--duration-slow) var(--ease-out) both;
  }

  :global(html[data-motion]) .home-intro__text {
    animation-delay: 40ms;
  }

  :global(html[data-motion]) .projects-grid > li {
    animation-delay: 80ms;
  }

  :global(html[data-motion]) .projects-grid > li:nth-child(2) {
    animation-delay: 120ms;
  }

  :global(html[data-motion]) .projects-grid > li:nth-child(3) {
    animation-delay: 160ms;
  }

  :global(html[data-motion]) .projects-grid > li:nth-child(4) {
    animation-delay: 200ms;
  }
</style>
