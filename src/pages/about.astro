---
// About. Text lives in src/data/about.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseImage from '../components/CaseImage.astro';
import Divider from '../components/Divider.astro';
import { about } from '../data/about';
import { site } from '../data/site';
---

<BaseLayout title="About" active="about" image={about.poster.src}>
  <div class="about">
    <div class="about__bio-row">
      <div class="about__text">
        <h1 class="t-h1">{about.heading}</h1>
        <div class="about__body t-body">
          {about.bio.map((p) => <p>{p}</p>)}
          <p>
            {about.contactLead}{' '}
            <a class="about__email" href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>
      </div>
      <div class="about__poster">
        <CaseImage
          src={about.poster.src}
          alt={about.poster.alt}
          widths={[360, 488, 720, 976, 1373]}
          sizes="(min-width: 64em) calc((100vw - 464px) / 2), (min-width: 48em) calc((100vw - 96px) / 2), calc(100vw - 32px)"
          loading="eager"
        />
      </div>
    </div>

    <Divider />

    <div class="about__resume">
      {
        about.resume.map((col) => (
          <section class:list={['about__col', { 'about__col--whole-lines': col.keepLinesWhole }]}>
            <h2 id={`resume-${col.heading.toLowerCase()}`} class="t-h2">
              {col.heading}
            </h2>
            <ul class:list={['about__list', 't-body', { 'about__list--spaced': col.spaced }]} role="list">
              {col.items.map((item) => (
                <li>
                  {item.lines.map((line) => (
                    <span class="about__line">{line}</span>
                  ))}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: var(--page-stack-gap);
    color: var(--text-primary);
  }

  .about__bio-row {
    display: flex;
    flex-direction: column;
    gap: var(--page-stack-gap);
  }

  /* Side by side only from 85em. Below that each column is under 450px, which
     is too narrow a measure for the bio and leaves the poster shorter than the
     text, so the two stack instead. */
  @media (min-width: 85em) {
    .about__bio-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* The poster cell takes the row's height, which the text sets. */
      align-items: stretch;
    }
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* The bio had no measure of its own and ran to 728px on a wide screen. The
     rest of the site caps prose at 640 (see CaseHero and the stacked case
     sections); this brings the About page into line. */
  @media (min-width: 48em) {
    .about__text {
      max-width: 640px;
    }
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  /* A real link, so it is underlined to stand apart from the text around it. */
  .about__email {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* Poster box: 488x648, 336x448, 361x480 in the frames (3:4) */
  .about__poster {
    aspect-ratio: 488 / 648;
    overflow: hidden;
  }

  /* Must come after the rule above: same specificity, and the media query adds
     none, so source order is what decides. */
  @media (min-width: 85em) {
    /* The poster is a tall 2:3 graphic standing next to text of unpredictable
       length, so it cannot both fill its column and end level with the text.
       Cropping is not an option either: the composition puts a photo in each
       corner, so any meaningful crop cuts them off.
       So the text decides the height. The image is taken out of flow, which
       stops it setting the row height, and scaled to fit the cell. Whenever it
       would overshoot the text, which is what happens on wide screens, it
       shrinks until the two bottoms line up. Where the text is the taller of
       the two it keeps its natural size, as before. */
    .about__poster {
      position: relative;
      aspect-ratio: auto;
      min-height: 0;
    }

    .about__poster :global(.case-image) {
      position: absolute;
      inset: 0;
      /* The placeholder tint would otherwise show as a block of green wherever
         the contained image does not reach. */
      background: none;
    }

    .about__poster :global(.case-image img) {
      object-fit: contain;
      object-position: top right;
    }
  }

  .about__resume {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-24);
  }

  @media (min-width: 48em) {
    .about__resume {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-32);
    }
  }

  /* Four columns once there is room for the Experience lines to stay whole
     (the 1440 frame). Between 1024 and 1199px the 2x2 tablet layout is used. */
  @media (min-width: 75em) {
    .about__resume {
      display: flex;
      gap: var(--meta-col-gap);
    }

    .about__col {
      flex: 1 1 0;
      min-width: 0;
    }

    .about__col--whole-lines {
      flex: 0 0 auto;
    }

    .about__col--whole-lines .about__line {
      white-space: nowrap;
    }
  }

  .about__line {
    display: block;
  }

  .about__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .about__list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .about__list--spaced {
    gap: var(--space-16);
  }

  @keyframes about-rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* The same reading order the other pages arrive in: the greeting, then what
     it says, then the poster, then the resume. Gated on data-first-load so it
     plays on arrival and never on top of a page transition (see BaseLayout). */
  :global(html[data-motion][data-first-load]) .about__text > h1,
  :global(html[data-motion][data-first-load]) .about__body,
  :global(html[data-motion][data-first-load]) .about__poster,
  :global(html[data-motion][data-first-load]) .about__resume {
    animation: about-rise var(--duration-slow) var(--ease-out) both;
  }

  :global(html[data-motion][data-first-load]) .about__body {
    animation-delay: var(--stagger-beat);
  }

  :global(html[data-motion][data-first-load]) .about__poster {
    animation-delay: calc(var(--stagger-beat) * 2);
  }

  :global(html[data-motion][data-first-load]) .about__resume {
    animation-delay: calc(var(--stagger-beat) * 3);
  }
</style>
