---
// Figma: NextProject. A full-width link to the next case study at the end of a
// case study. Its accessible name reads "Next project: <title>".
import Icon from './Icon.astro';

interface Props {
  href: string;
  title: string;
  label?: string;
}

const { href, title, label = 'Next project' } = Astro.props;
---

<a class="next-project" href={href}>
  <span class="next-project__text">
    <span class="t-eyebrow next-project__label">{label}<span class="sr-only">: </span></span>
    <span class="t-h2 next-project__title">{title}</span>
  </span>
  <Icon name="next" size={24} class="next-project__icon" />
</a>

<style>
  .next-project {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    padding-block: var(--space-32);
    color: var(--text-primary);
  }

  .next-project__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-width: 0;
  }

  .next-project__label {
    color: var(--text-muted);
  }

  .next-project__title {
    text-underline-offset: 4px;
  }

  .next-project :global(.next-project__icon) {
    flex: none;
    color: var(--icon-default);
    transition:
      transform var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  /* This link is the last thing on a case study, so it is what the visitor
     leaves with. The arrow moves the way the link goes. Hover only where there
     is a real pointer, as on the project tiles. */
  @media (hover: hover) and (pointer: fine) {
    .next-project:hover .next-project__title {
      text-decoration: underline;
    }

    .next-project:hover :global(.next-project__icon) {
      transform: translateX(4px);
      color: var(--text-primary);
    }
  }

  /* Keyboard gets the same answer, on top of the focus ring. */
  .next-project:focus-visible .next-project__title {
    text-decoration: underline;
  }

  .next-project:focus-visible :global(.next-project__icon) {
    transform: translateX(4px);
    color: var(--text-primary);
  }
</style>
