---
// Figma: NavSidebar (Active=Projects | About | None). Desktop only (>= 1024px),
// fixed to the left edge. Below 1024px SiteHeader + MenuDrawer take over.
import AvatarWave from './AvatarWave.astro';
import NavLinks from './NavLinks.astro';
import SocialLinks from './SocialLinks.astro';
import { site, type NavKey } from '../data/site';

interface Props {
  active?: NavKey;
}

const { active } = Astro.props;
---

<header class="nav-sidebar">
  <div class="nav-sidebar__top">
    <div class="nav-sidebar__identity">
      <AvatarWave size={48} interaction="hover" />
      <div class="nav-sidebar__name-block">
        <p class="t-brand">{site.name}</p>
        <p class="t-body nav-sidebar__role">{site.role}</p>
      </div>
    </div>
    <NavLinks active={active} variant="sidebar" />
  </div>
  <SocialLinks variant="sidebar" />
</header>

<style>
  .nav-sidebar {
    display: none;
  }

  @media (min-width: 64em) {
    .nav-sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 10;
      display: flex;
      flex-direction: column;
      gap: var(--space-64);
      width: var(--layout-sidebar-width);
      padding: var(--space-64) var(--space-40) var(--space-48);
      overflow-y: auto;
      background: var(--surface-subtle);
    }
  }

  .nav-sidebar__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  .nav-sidebar__identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .nav-sidebar__name-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-sidebar__role {
    color: var(--text-muted);
  }
</style>
