---
// Figma: CaseSection (Layout=Stacked | Split; Breakpoint=Desktop | Tablet | Mobile).
// Eyebrow ("02 · Constraints") + H2 + paragraphs + optional image.
// Stacked: full-width image under the text. Split: text 5/11, image 6/11.
// Mobile is always stacked, and a split section shows its imageMobile there.
import CaseImage from './CaseImage.astro';
import { imageSizes } from '../lib/image-sizes';

interface Props {
  /** 1-based position, shown as "01", "02"... */
  number: number;
  eyebrow: string;
  heading: string;
  paragraphs: string[];
  layout: 'stacked' | 'split';
  image?: string;
  imageMobile?: string;
  alt?: string;
  /** Optional link out, e.g. to the live product. Opens in a new tab. */
  link?: { href: string; label: string };
}

const { number, eyebrow, heading, paragraphs, layout, image, imageMobile, alt = '', link } = Astro.props;
const id = `section-${String(number).padStart(2, '0')}`;
const size = layout === 'split' ? imageSizes.split : imageSizes.wide;
---

<section class:list={['case-section', `case-section--${layout}`, { 'case-section--has-image': image }]}>
  <div class="case-section__text">
    {/* Eyebrow and heading travel together: in the full-width row they are one
        block centred against the body beside them. */}
    <div class="case-section__head">
      <p class="t-eyebrow case-section__eyebrow">{String(number).padStart(2, '0')} · {eyebrow}</p>
      <h2 id={id} class="t-h2">{heading}</h2>
    </div>
    <div class="case-section__body t-body">
      {paragraphs.map((p) => <p>{p}</p>)}
      {
        link && (
          <p class="case-section__link">
            {/* The visible label stays the start of the accessible name, so it
                still satisfies "label in name" (WCAG 2.5.3). */}
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <span class="sr-only"> (opens in new tab)</span>
            </a>
          </p>
        )
      }
    </div>
  </div>
  {
    image && (
      <div class="case-section__media">
        <CaseImage
          src={image}
          mobileSrc={layout === 'split' ? imageMobile : undefined}
          alt={alt}
          widths={size.widths}
          sizes={size.sizes}
          mobileWidths={imageSizes.splitMobile.widths}
          mobileSizes={imageSizes.splitMobile.sizes}
        />
      </div>
    )
  }
</section>

<style>
  .case-section {
    display: flex;
    flex-direction: column;
    gap: var(--page-stack-gap);
  }

  .case-section__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .case-section__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .case-section__eyebrow {
    color: var(--text-muted);
  }

  .case-section__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  /* Underlined rather than colour alone, so it reads as a link without relying
     on the green. Same hover language as the nav and the Next project link. */
  .case-section__link a {
    color: var(--text-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .case-section__link a:hover {
      color: var(--text-primary);
    }
  }

  /* Mobile image box: 361x200 in the frames. overflow keeps the box at its
     aspect ratio instead of growing to the image's own height. */
  .case-section__media {
    aspect-ratio: 361 / 200;
    overflow: hidden;
  }

  @media (min-width: 48em) {
    .case-section--stacked .case-section__text {
      max-width: 560px;
    }

    .case-section--stacked .case-section__media {
      aspect-ratio: 704 / 400;
    }

    .case-section--split.case-section--has-image {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      gap: var(--space-32);
    }

    .case-section--split .case-section__media {
      aspect-ratio: 336 / 256;
    }
  }

  @media (min-width: 64em) {
    .case-section--stacked .case-section__text {
      max-width: 640px;
    }

    .case-section--stacked .case-section__media {
      aspect-ratio: 1008 / 568;
    }

    .case-section--split.case-section--has-image {
      grid-template-columns: minmax(0, 440fr) minmax(0, 536fr);
    }

    .case-section--split .case-section__media {
      aspect-ratio: 536 / 400;
    }
  }

  /* From 1440 up a split section gives the screens more room: a narrower text
     column against a wider image. The image stays inside the page padding,
     lining up with the hero and the stacked sections. Held back to 90em
     because at 1024 the text column would be about 200px wide. The aspect
     ratio is unchanged, so the box still has a known height and CLS stays at
     0. `sizes` in src/lib/image-sizes.ts has the matching formula: change one
     and the image is served at the wrong size. */
  @media (min-width: 90em) {
    .case-section--split.case-section--has-image {
      grid-template-columns: minmax(0, 360fr) minmax(0, 616fr);
    }
  }

  /* A split section without an image reads like a stacked one. */
  .case-section--split:not(.case-section--has-image) .case-section__text {
    max-width: 640px;
  }

  /* A section with no image used to be a 640px block of text with the rest of
     the content column empty beside it, which got worse as the copy got
     shorter. On desktop it now runs across the full width as one row:
     eyebrow, heading, body. Pattern from editorial process lists (Craft
     Agency, Trawelt on Mobbin). Must stay after the max-width rules above,
     which have the same specificity. */
  @media (min-width: 64em) {
    .case-section:not(.case-section--has-image) .case-section__text {
      display: grid;
      /* The same 440/536 split a section with an image uses, so the eyebrow
         and heading stay flush left and the body starts exactly where an
         image would. One grid runs down the whole page. */
      grid-template-columns: minmax(0, 440fr) minmax(0, 536fr);
      /* Centred against each other, not hung from the top. Both columns are a
         single block, so whichever is shorter sits in the middle of the taller
         one. */
      align-items: center;
      column-gap: var(--space-32);
      max-width: none;
    }

    /* A rule between two rows in a row, so a run of them reads as one list.
       Only between two of them, so it never doubles the divider under the meta
       row or hangs under an image. */
    .case-section:not(.case-section--has-image)
      + .case-section:not(.case-section--has-image) {
      border-top: 1px solid var(--border-divider);
      padding-top: var(--space-32);
    }
  }
</style>
