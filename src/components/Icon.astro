  // Icon/LinkedIn: 16px box
  linkedin: {
    w: 16,
    h: 16,
    body: '<path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M0.666504 1.89184C0.666857 1.56697 0.796067 1.25551 1.02579 1.02579C1.2555 0.796069 1.56697 0.666858 1.89184 0.666506H14.1065C14.2676 0.666243 14.4271 0.697747 14.5759 0.759217C14.7248 0.820686 14.8601 0.910912 14.974 1.02473C15.0879 1.13855 15.1783 1.27372 15.24 1.42251C15.3016 1.5713 15.3333 1.73079 15.3332 1.89184V14.1065C15.3332 14.4317 15.204 14.7436 14.9741 14.9737C14.7442 15.2037 14.4324 15.333 14.1072 15.3332H1.89184C1.56685 15.3328 1.25529 15.2035 1.02555 14.9737C0.795813 14.7438 0.66668 14.4322 0.666504 14.1072V1.89184ZM6.47184 6.25851H8.45784V7.25584C8.7445 6.68251 9.47784 6.16651 10.5798 6.16651C12.6925 6.16651 13.1932 7.30851 13.1932 9.40384V13.2852H11.0552V9.88117C11.0552 8.68784 10.7685 8.01451 10.0405 8.01451C9.0305 8.01451 8.6105 8.74051 8.6105 9.88117V13.2852H6.47184V6.25851ZM2.80517 13.1938H4.94384V6.16651H2.80517V13.1938ZM5.24984 3.87451C5.25387 4.05762 5.22129 4.2397 5.154 4.41005C5.08671 4.5804 4.98607 4.7356 4.85799 4.86653C4.72991 4.99746 4.57697 5.10149 4.40814 5.17251C4.23931 5.24353 4.058 5.28012 3.87484 5.28012C3.69168 5.28012 3.51036 5.24353 3.34153 5.17251C3.1727 5.10149 3.01976 4.99746 2.89168 4.86653C2.7636 4.7356 2.66297 4.5804 2.59568 4.41005C2.52839 4.2397 2.49581 4.05762 2.49984 3.87451C2.50775 3.51508 2.65609 3.17303 2.91309 2.92163C3.17009 2.67023 3.51532 2.52945 3.87484 2.52945C4.23435 2.52945 4.57958 2.67023 4.83658 2.92163C5.09358 3.17303 5.24192 3.51508 5.24984 3.87451Z"/>',
  },
};

const { name, size, class: className } = Astro.props;
const icon = icons[name];
const height = size ?? icon.h;
const width = (icon.w / icon.h) * height;
---

<svg
  class:list={['icon', className]}
  width={width}
  height={height}
  viewBox={`0 0 ${icon.w} ${icon.h}`}
  aria-hidden="true"
  focusable="false"
  set:html={icon.body}
/>

<style>
  .icon {
    flex: none;
  }
</style>
